import objetos.*
describe "Messi patea la pelota" {
    test "y esta se mueve 3 a la derecha" {
        assert.throwsException({lionel.patear()})

        pelota.inicio()
        lionel.buscar()

        assert.equals(lionel.position(), pelota.position())

        lionel.patear()

        assert.equals(pelota.position(), game.at(3,5))

        lionel.position(game.at(14,5))
        pelota.position(game.at(14,5))

        lionel.patear()
    }
}